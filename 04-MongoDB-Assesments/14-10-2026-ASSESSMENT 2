// Q1. Display all restaurants.
db.restaurants.find();


// Q2. Find only restaurants from Hyderabad.
db.restaurants.find({ city: "Hyderabad" });


// Q3. Find active restaurants having rating greater than 4.3.
db.restaurants.find({ active: true, rating: { $gt: 4.3 } });


// Q4. Insert one new restaurant of your choice.
db.restaurants.insertOne({ restaurant_id: 106, restaurant_name: "Tasty Treats", city: "Chennai", cuisine: ["Indian", "Desserts"], rating: 4.1, active: true, contact: { phone: "9876501234", email: "tasty@email.com" } });


// Q5. Change the rating of restaurant 104 to 4.3.
db.restaurants.updateOne({ restaurant_id: 104 }, { $set: { rating: 4.3 } });


// Q6. Change restaurant 104 from inactive to active.
db.restaurants.updateOne({ restaurant_id: 104 }, { $set: { active: true } });


// Q7. Delete the restaurant inserted in Question 89.
db.restaurants.deleteOne({ restaurant_id: 106 });



// Q8. Find restaurants serving Fast Food.
db.restaurants.find({ cuisine: "Fast Food" });


// Q9. Find restaurants serving both Italian and Fast Food.
db.restaurants.find({ cuisine: { $all: ["Italian", "Fast Food"] } });


// Q10. Add Desserts to the cuisine list of restaurant 102.
db.restaurants.updateOne({ restaurant_id: 102 }, { $addToSet: { cuisine: "Desserts" } });


// Q11. Change the email address of restaurant 103.
db.restaurants.updateOne({ restaurant_id: 103 }, { $set: { "contact.email": "greenbowl@email.com" } });


// Q12. Display restaurants whose contact phone starts with 9.
db.restaurants.find({ "contact.phone": /^9/ });


// Q13. Find all Delivered orders.
db.orders.find({ status: "Delivered" });


// Q14. Find orders placed after 2026-09-02.
db.orders.find({ order_date: { $gt: ISODate("2026-09-02") } });


// Q15. Find orders delivered to Hyderabad.
db.orders.find({ "delivery.city": "Hyderabad" });


// Q16. Find orders containing an item named Noodles.
db.orders.find({ "items.name": "Noodles" });


// Q17. Find orders containing an item where quantity is greater than 1.
db.orders.find({ "items.quantity": { $gt: 1 } });


// Q18. Find an order where the same item has name = Chicken Biryani AND quantity = 2.
db.orders.find({ items: { $elemMatch: { name: "Chicken Biryani", quantity: 2 } } });


// Q19. Add another item to order 5002.
db.orders.updateOne({ order_id: 5002 }, { $push: { items: { name: "Garlic Bread", quantity: 1, price: 180 } } });


// Q20. Change order 5002 from Processing to Delivered.
db.orders.updateOne({ order_id: 5002 }, { $set: { status: "Delivered" } });



// Q21. Display restaurant_name, city and rating without _id.
db.restaurants.find({}, { _id: 0, restaurant_name: 1, city: 1, rating: 1 });


// Q22. Sort restaurants by rating from highest to lowest.
db.restaurants.find().sort({ rating: -1 });


// Q23. Display the top 3 highest-rated restaurants.
db.restaurants.find().sort({ rating: -1 }).limit(3);



// Q24. Find documents where rating is stored as a numeric value.
db.restaurants.find({ rating: { $type: "number" } });


// Q25. Identify the datatype of order_date.
db.orders.aggregate([{ $project: { _id: 0, order_id: 1, order_date: 1, order_date_type: { $type: "$order_date" } } }]);


// Q26. Identify the datatype of items.
db.orders.aggregate([{ $project: { _id: 0, order_id: 1, items_type: { $type: "$items" } } }]);


