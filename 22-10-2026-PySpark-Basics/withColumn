from pyspark.sql import SparkSession

spark = SparkSession.builder \
    .appName("WithColumnExample") \
    .getOrCreate()

data = [(101, "Laptop", 65000),
    (102, "Mouse", 1500),
    (103, "Monitor", 18000)]

columns = ["product_id", "product_name", "price"]

df = spark.createDataFrame(data, columns)



1. add new column
df1 = df.withColumn("available", df.price > 5000)
df1.show()



2. calculating with Gst
df1 = df.withColumn(
    "price_with_gst",
    df.price * 1.18)
df1.show()


3. increse price
df1 = df.withColumn("price", df.price + 500)
df1.show()


